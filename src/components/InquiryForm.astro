---
import {services} from '../data/services.js';
const configured=import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const endpoint=/^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(configured)?configured:'';
---
{!endpoint&&<p class="form-notice" role="status">Complete your project details below, then open an email to <a href="mailto:theoddphoenix@outlook.com">theoddphoenix@outlook.com</a>. Review and send it in your email app.</p>}
<form id="project-inquiry" action={endpoint||undefined} method="post" data-ready={Boolean(endpoint)}><fieldset><legend>Project inquiry <span>(required fields are marked *)</span></legend><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required maxlength="150"/><label for="email">Email Address *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"/><label for="description">Project Description *</label><textarea id="description" name="description" required rows="6" maxlength="10000"/><fieldset class="checkboxes"><legend>Services Interested In</legend>{services.map(s=><label><input type="checkbox" name="services" value={s.title}/>{s.title}</label>)}</fieldset><details class="optional-fields"><summary>Add timeline, budget, or other details (optional)</summary><label for="organization">Business / Organization</label><input id="organization" name="organization" autocomplete="organization" maxlength="200"/><label for="timeline">Desired Timeline</label><input id="timeline" name="timeline" maxlength="200"/><label for="budget">Estimated Budget</label><input id="budget" name="budget" maxlength="200"/><label for="additional">Additional Information</label><textarea id="additional" name="additional" rows="3" maxlength="5000"/></details><div class="honeypot" aria-hidden="true"><label for="company-website">Leave this field empty</label><input id="company-website" name="_gotcha" tabindex="-1" autocomplete="off"/></div><p>Your details are used to respond to your inquiry. Without an online form connection, your details stay in this page until you open your email app.</p><button class="button" type="submit">{endpoint ? 'Send project inquiry' : 'Open inquiry in email app'} <span aria-hidden="true">↗</span></button></fieldset><p id="form-status" role="status" aria-live="polite" tabindex="-1"></p></form>
<script>const form=document.querySelector('#project-inquiry');if(form instanceof HTMLFormElement){form.addEventListener('submit',async event=>{event.preventDefault();if(form.dataset.ready!=='true'){const data=new FormData(form);if(data.get('_gotcha'))return;const body=['Name: '+data.get('name'),'Email: '+data.get('email'),'Services: '+data.getAll('services').join(', '),'Project: '+data.get('description'),'Organization: '+(data.get('organization')||''),'Timeline: '+(data.get('timeline')||''),'Budget: '+(data.get('budget')||''),'Additional details: '+(data.get('additional')||'')].join('\n\n');window.location.href='mailto:theoddphoenix@outlook.com?subject='+encodeURIComponent('Project inquiry — The Odd Phoenix')+'&body='+encodeURIComponent(body);const message=document.querySelector('#form-status');if(message)message.textContent='Your email app has been requested. Review and send the message there. If it does not open, email theoddphoenix@outlook.com directly. Your details remain here.';return;}const status=document.querySelector('#form-status');const button=form.querySelector('button');if(!(status instanceof HTMLElement)||!(button instanceof HTMLButtonElement))return;button.disabled=true;status.textContent='Sending your inquiry…';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Submission failed');status.textContent='Thank you. Your project inquiry was submitted successfully. The studio will review your details and respond to the email address you provided.';form.reset();}catch{status.textContent='Your inquiry could not be confirmed. Please try again. Your details are still in the form.';}finally{button.disabled=false;status.focus();}});}</script>
