---
import {studioServices} from '../data/studio-services.js';
const configured=import.meta.env.PUBLIC_FORM_ENDPOINT||'';
const endpoint=/^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(configured)?configured:'';
---
<div>{!endpoint&&<p class="form-notice" role="status">Online submission is awaiting the studio’s verified form connection. You can prepare your details below or contact <a href="mailto:theoddphoenix@outlook.com">theoddphoenix@outlook.com</a> directly.</p>}<form id="project-inquiry" action={endpoint||undefined} method="post" data-ready={Boolean(endpoint)}><fieldset><legend>Project inquiry <span>Fields marked * are required.</span></legend><div class="field-pair"><div><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required maxlength="150"/></div><div><label for="email">Email *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"/></div></div><label for="description">What do you have in mind? *</label><textarea id="description" name="description" rows="5" required maxlength="10000"/><fieldset class="checkboxes"><legend>Services you’re interested in <span>Optional</span></legend>{studioServices.map(s=><label><input type="checkbox" name="services" value={s.heading} data-service={s.id}/>{s.heading}</label>)}</fieldset><details class="optional-fields"><summary>Add project details (optional)</summary><label for="organization">Business / organization</label><input id="organization" name="organization" autocomplete="organization" maxlength="200"/><label for="timeline">Timeline</label><input id="timeline" name="timeline" maxlength="200"/><label for="budget">Budget</label><input id="budget" name="budget" maxlength="200"/><label for="additional">Anything else?</label><textarea id="additional" name="additional" rows="3" maxlength="5000"/></details><div class="honeypot" aria-hidden="true"><label for="company-website">Leave this field empty</label><input id="company-website" name="_gotcha" tabindex="-1" autocomplete="off"/></div><p class="privacy-note">Your details are used to respond to your inquiry. Online submissions are processed by Formspree when the form is connected.</p><button class="button ink" type="submit" disabled={!endpoint}>{endpoint?'Send project inquiry':'Online submission not connected'} <span aria-hidden="true">↗</span></button></fieldset><p id="form-status" role="status" aria-live="polite" tabindex="-1"></p><noscript><p>JavaScript is optional when online submission is connected. You can also email the studio directly.</p></noscript></form></div>
<script>
const form=document.querySelector('#project-inquiry');if(form instanceof HTMLFormElement){const requested=new URLSearchParams(window.location.search).get('service');for(const checkbox of form.querySelectorAll<HTMLInputElement>('input[data-service]'))if(checkbox.dataset.service===requested)checkbox.checked=true;form.addEventListener('submit',async event=>{event.preventDefault();const status=document.querySelector('#form-status');const button=form.querySelector('button');if(!(status instanceof HTMLElement)||!(button instanceof HTMLButtonElement))return;if(form.dataset.ready!=='true'){status.textContent='Online submission is not connected yet. Please email theoddphoenix@outlook.com.';status.focus();return;}if(!form.reportValidity())return;const data=new FormData(form);if(data.get('_gotcha'))return;button.disabled=true;status.textContent='Sending your inquiry…';try{const response=await fetch(form.action,{method:'POST',body:data,headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Submission failed');status.textContent='Thank you. Your inquiry was submitted successfully. We’ll respond to the email address you provided.';form.reset();}catch{status.textContent='Your inquiry could not be confirmed. Please try again or email theoddphoenix@outlook.com. Your details remain in the form.';}finally{button.disabled=false;status.focus();}});}
</script>