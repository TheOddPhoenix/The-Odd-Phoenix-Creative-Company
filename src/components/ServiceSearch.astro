---
import {studioServices} from '../data/studio-services.js';
const synonymGroups=[[/Shopify|Etsy|store|catalog|print-on-demand/i,'ecommerce e commerce web shop webshop shopping cart online retail POD shop setup'],[/proof|copyedit|document editing/i,'proof reading copy editing spell check grammar editor'],[/logo/i,'fix my logo blurry logo vector vectorize refresh logo redesign'],[/presentation/i,'PowerPoint slides pitch deck slideshow'],[/flyer|poster|brochure/i,'leaflet handout promotional print'],[/AI-generated/i,'AI content editing artificial intelligence humanize'],[/website copy|SEO-friendly/i,'SEO copywriting website text'],[/press release|public relations/i,'PR publicity media relations'],[/photography|headshot|portrait/i,'photos photographer pictures'],[/video/i,'film reels videographer'],[/social media|content calendar/i,'instagram facebook linkedin posts captions content creator'],[/project/i,'project management coordination planning']];
const catalog=studioServices.flatMap((category)=>category.items.map(name=>({name,category:category.title,href:import.meta.env.BASE_URL+'services/#'+category.id,terms:name+' '+category.title+' '+synonymGroups.filter(([pattern])=>(pattern as RegExp).test(name)).map(([,terms])=>terms).join(' ')})));
---
<section class="service-search" aria-label="Find a service" data-catalog={JSON.stringify(catalog)}>
  <label for="service-query">Search for a service</label>
  <div class="search-controls"><input id="service-query" type="search" placeholder="Try proofreading, logo cleanup, or presentation design" autocomplete="off" aria-controls="service-results"/><button type="button" class="search-clear">Clear</button></div>
  <p class="search-status" role="status" aria-live="polite"></p>
  <ul id="service-results" class="search-results" hidden></ul>
  <noscript><p>Browse the service categories below to find the support you need.</p></noscript>
</section>
<script>
for(const region of document.querySelectorAll<HTMLElement>('.service-search')){
 const input=region.querySelector('input'),results=region.querySelector('ul'),status=region.querySelector('.search-status'),clear=region.querySelector('button');
 const catalog=JSON.parse(region.dataset.catalog||'[]') as {name:string;category:string;href:string;terms:string}[];
 const normalize=(s:string)=>s.toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
 if(!input||!results||!status)continue;
 const update=()=>{const query=normalize(input.value);results.replaceChildren();results.hidden=!query;if(!query){status.textContent='';return;}
 const tokens=query.split(' ').filter(t=>!['a','an','the','my','for','and','service','services','help','with'].includes(t));
 const matches=catalog.map(item=>({item,score:tokens.reduce((n,t)=>n+(normalize(item.name).includes(t)?4:normalize(item.terms).includes(t)?1:0),0),match:tokens.every(t=>normalize(item.terms).includes(t))})).filter(x=>tokens.length&&x.match).sort((a,b)=>b.score-a.score).slice(0,12);
 status.textContent=matches.length?`${matches.length} matching service${matches.length===1?'':'s'}${matches.length===12?' (showing the closest matches)':''}.`:'No matching services. Try a shorter phrase or contact us to discuss your project.';
 for(const {item} of matches){const li=document.createElement('li'),link=document.createElement('a'),small=document.createElement('small');link.href=item.href;link.textContent=item.name;small.textContent=item.category;link.append(small);li.append(link);results.append(li);}};
 input.addEventListener('input',update);clear?.addEventListener('click',()=>{input.value='';update();input.focus();});
}
</script>
