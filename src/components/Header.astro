---
import Logo from './Logo.astro';
const base=import.meta.env.BASE_URL;
const pages=[['Services','services'],['About','about'],['Contact','contact']];
---
<header class="site-header wrap"><a class="logo-link" href={base} aria-label="The Odd Phoenix Creative Company — home"><Logo/></a><nav aria-label="Main navigation">{pages.map(([label,id])=><a class:list={{'nav-cta':id==='contact'}} href={`${base}#${id}`}>{id==='contact'?'Discuss your project':label}</a>)}</nav></header>
