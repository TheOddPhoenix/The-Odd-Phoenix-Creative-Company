---
const base=import.meta.env.BASE_URL;
const pages=[['Home',''],['About','about/'],['Services','services/'],['Portfolio','portfolio/'],['Contact','contact/']];
---
<header class="site-header wrap"><a class="studio-name" href={base}>ODD PHOENIX <span>CREATIVE COMPANY</span></a><nav aria-label="Main navigation">{pages.map(([label,path])=><a href={`${base}${path}`} aria-current={Astro.url.pathname===`${base}${path}`?'page':undefined}>{label}{label==='Contact'&&<span aria-hidden="true"> ↗</span>}</a>)}</nav></header>
