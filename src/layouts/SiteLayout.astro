---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const {title,description,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const preview=import.meta.env.PUBLIC_SITE_PREVIEW==='true';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | The Odd Phoenix</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={preview||noindex?'noindex, follow':'index, follow'}/><meta name="theme-color" content="#17171A"/><meta property="og:title" content={`${title} | The Odd Phoenix`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="The Odd Phoenix"/><link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL+'favicon.svg'}/><meta property="og:image" content={new URL(import.meta.env.BASE_URL+'images/editorial.webp',Astro.site)}/><meta property="og:image:alt" content="Vintage typewriter — The Odd Phoenix"/><meta property="og:image:width" content="480"/><meta property="og:image:height" content="640"/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization','@id':'https://theoddphoenix.com/#organization',name:'The Odd Phoenix',legalName:'The Odd Phoenix LLC',url:'https://theoddphoenix.com/',email:'theoddphoenix@outlook.com',description:'Independent strategic communications and creative-services company providing writing, design, digital content, e-commerce, and website support.'})}/></head><body id="home"><a class="skip" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/></body></html>

