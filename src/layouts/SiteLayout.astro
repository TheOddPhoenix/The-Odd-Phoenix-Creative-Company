---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const {title,description,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const preview=import.meta.env.PUBLIC_SITE_PREVIEW==='true';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Odd Phoenix Creative Company</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={preview||noindex?'noindex, follow':'index, follow'}/><meta name="theme-color" content="#2F4732"/><meta property="og:title" content={`${title} | Odd Phoenix Creative Company`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Odd Phoenix Creative Company"/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization','@id':'https://theoddphoenix.com/#organization',name:'Odd Phoenix Creative Company',url:'https://theoddphoenix.com/',description:'Independent multidisciplinary creative studio providing writing, graphic design, photography, video, public relations, digital content, and website services.'})}/></head><body id="home"><a class="skip" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/></body></html>
