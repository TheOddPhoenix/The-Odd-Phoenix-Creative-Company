---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceSearch from '../components/ServiceSearch.astro';
import ContactStrip from '../components/ContactStrip.astro';
import {serviceGuidance} from '../data/service-guidance.js';
import {studioServices} from '../data/studio-services.js';
const base=import.meta.env.BASE_URL;
---
<SiteLayout title="Writing, Design, Communications & E-Commerce Services" description="Explore strategic communications, writing and editing, branding, photography, social media, Shopify and Etsy setup, website design, and SEO. Custom project quotes."><PageHeader eyebrow="Oddly versatile" title="Communications & creative services" description="Find support for a specific task or a connected project. Explore what each service can include, what to bring, and how to get started."/><div class="catalog texture"><div class="wrap"><ServiceSearch/><nav class="service-jump" aria-label="Service categories">{studioServices.map(s=><a href={'#'+s.id}>{s.heading}</a>)}</nav></div>{studioServices.map(s=><section class="offering wrap" id={s.id}><div class="offering-intro"><p class="eyebrow">The Odd Phoenix</p><h2>{s.heading}</h2><p>{s.description}</p>{s.id==='commerce'&&<p class="editorial commerce-pitch">Selling something?<br/>Let’s make it look good.</p>}<a class="button ink" href={base+'contact/?service='+s.id}>Discuss your project <span aria-hidden="true">↗</span></a></div><div class="offering-detail"><div class="service-guidance"><h3>A good fit when</h3><p>{serviceGuidance[s.id].need}</p><h3>What you can receive</h3><p>{serviceGuidance[s.id].deliverable}</p><h3>What helps us get started</h3><p>{serviceGuidance[s.id].prepare}</p></div><details class="offering-options"><summary>Browse individual services</summary><ul class="offering-list">{s.items.map(item=><li>{item}</li>)}</ul></details></div></section>)}<div class="wrap quote-note"><p>Every project begins with a conversation. Scope, timing, and pricing are agreed through consultation.</p></div></div><ContactStrip/></SiteLayout>
<script>
const revealLinkedServices=()=>{const target=document.getElementById(window.location.hash.slice(1));const details=target?.querySelector('.offering-options');if(details instanceof HTMLDetailsElement)details.open=true;};
revealLinkedServices();window.addEventListener('hashchange',revealLinkedServices);
</script>
