---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import {services} from '../data/services.js';
import {offerings} from '../data/service-details.js';
const base=import.meta.env.BASE_URL;
---
<SiteLayout title="Creative Services: Writing, Design, Public Relations & Websites" description="Explore writing and editing, graphic design, logo cleanup, photography, public relations, social media content, and WordPress website services. Custom project quotes."><PageHeader eyebrow="WHAT WE DO" title="CREATIVE SERVICES. CLEAR INTENT." description="One project or several connected needs. We bring the right creative disciplines together around your goals."/><nav class="wrap service-jump" aria-label="Service categories">{services.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav>{services.map((s,i)=><section class="wrap offering section" id={s.id}><div><p class="eyebrow">0{i+1} / CREATIVE SERVICES</p><h2>{s.title}</h2><p>{s.description}</p>{i===0&&<p>Clarity, accuracy, and an authentic voice guide every piece of writing.</p>}{i===2&&<p>Photography availability and location are discussed during consultation. Editing and production needs are scoped individually.</p>}{i===4&&<p>Support focuses on content creation and development. Account management and paid advertising are outside these listed services.</p>}<Button href={`${base}contact/`}>Discuss your project</Button></div><ul class="offering-list">{offerings[i].map(item=><li>{item}</li>)}</ul></section>)}<section class="wrap section"><p class="eyebrow">A PROJECT BUILT AROUND YOU</p><h2>START WITH A CONVERSATION.</h2><p>Every project begins with an inquiry, a consultation, and a customized quote.</p><Button href={`${base}contact/`}>Discuss your project</Button></section></SiteLayout>
