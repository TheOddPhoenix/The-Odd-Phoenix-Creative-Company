---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceSearch from '../components/ServiceSearch.astro';
import ContactStrip from '../components/ContactStrip.astro';
import {studioServices} from '../data/studio-services.js';
const base=import.meta.env.BASE_URL;
---
<SiteLayout title="Writing, Design, Communications & E-Commerce Services" description="Explore strategic communications, writing and editing, branding, photography, social media, Shopify and Etsy setup, website design, and SEO. Custom project quotes."><PageHeader eyebrow="What we do" title="Oddly versatile." description="One project or several connected needs. Practical support, thoughtful execution, and a quote built around your scope."/><div class="catalog texture"><div class="wrap"><ServiceSearch/><nav class="service-jump" aria-label="Service categories">{studioServices.map(s=><a href={'#'+s.id}>{s.heading}</a>)}</nav></div>{studioServices.map(s=><section class="offering wrap" id={s.id}><div class="offering-intro"><p class="eyebrow">The Odd Phoenix</p><h2>{s.heading}</h2><p>{s.description}</p>{s.id==='commerce'&&<p class="editorial commerce-pitch">Selling something?<br/>Let’s make it look good.</p>}<a class="button ink" href={base+'contact/?service='+s.id}>Discuss your project <span aria-hidden="true">↗</span></a></div><ul class="offering-list">{s.items.map(item=><li>{item}</li>)}</ul></section>)}<div class="wrap quote-note"><p>Every project begins with a conversation. Scope, timing, and pricing are agreed through consultation.</p></div></div><ContactStrip/></SiteLayout>