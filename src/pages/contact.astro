---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {services} from '../data/services.js';
const configured=import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const endpoint=/^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(configured)?configured:'';
---
<SiteLayout title="Contact & Project Inquiries" description="Discuss your writing, design, public relations, digital content, or website project with Odd Phoenix Creative Company. Consultation-based services and customized quotes."><PageHeader eyebrow="START A CONVERSATION" title="TELL US WHAT’S NEXT." description="Share your goals, what you need, and where you want to go. Every project starts with a conversation."/><section class="wrap inquiry-grid section"><div><h2>YOUR PROJECT</h2><p>Tell us as much as you can. A consultation helps clarify the scope before a customized proposal.</p>{!endpoint&&<p class="form-notice" role="status">Online inquiries are not available yet. This form will open once the studio’s receiving address and form service are connected. Nothing can be submitted from this preview.</p>}<ol class="consultation"><li><strong>INQUIRE</strong><p>Tell us about your project.</p></li><li><strong>CONSULT</strong><p>We’ll discuss your goals, needs, and scope.</p></li><li><strong>QUOTE</strong><p>Receive a customized proposal.</p></li><li><strong>CREATE</strong><p>Once approved, we’ll get to work.</p></li></ol></div><form id="project-inquiry" action={endpoint||undefined} method="post" data-ready={Boolean(endpoint)}><fieldset disabled={!endpoint}><legend>Project inquiry <span>(required fields are marked *)</span></legend><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required maxlength="150"/><label for="organization">Business / Organization</label><input id="organization" name="organization" autocomplete="organization" maxlength="200"/><label for="email">Email Address *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"/><fieldset class="checkboxes"><legend>Services Interested In</legend>{services.map(s=><label><input type="checkbox" name="services" value={s.title}/>{s.title}</label>)}</fieldset><label for="description">Project Description *</label><textarea id="description" name="description" required rows="6" maxlength="10000"/><label for="timeline">Desired Timeline</label><input id="timeline" name="timeline" maxlength="200"/><label for="budget">Estimated Budget</label><input id="budget" name="budget" maxlength="200"/><label for="additional">Additional Information</label><textarea id="additional" name="additional" rows="3" maxlength="5000"/><div class="honeypot" aria-hidden="true"><label for="company-website">Leave this field empty</label><input id="company-website" name="_gotcha" tabindex="-1" autocomplete="off"/></div><p>Information you submit is used to respond to your project inquiry. When enabled, this form is processed by Formspree.</p><button class="button" type="submit">Send project inquiry <span aria-hidden="true">↗</span></button></fieldset><p id="form-status" role="status" aria-live="polite" tabindex="-1"></p></form></section><script>const form=document.querySelector('#project-inquiry');if(form instanceof HTMLFormElement){form.addEventListener('submit',async event=>{event.preventDefault();if(form.dataset.ready!=='true')return;const status=document.querySelector('#form-status');const button=form.querySelector('button');if(!(status instanceof HTMLElement)||!(button instanceof HTMLButtonElement))return;button.disabled=true;status.textContent='Sending your inquiry…';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Submission failed');status.textContent='Thank you. Your project inquiry was submitted successfully. The studio will review your details and respond to the email address you provided.';form.reset();}catch{status.textContent='Your inquiry could not be confirmed. Please try again. Your details are still in the form.';}finally{button.disabled=false;status.focus();}});}</script></SiteLayout>
