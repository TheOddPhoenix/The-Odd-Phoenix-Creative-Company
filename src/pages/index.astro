---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStartingPoints from '../components/ProjectStartingPoints.astro';
import ProjectProcess from '../components/ProjectProcess.astro';
import ContactStrip from '../components/ContactStrip.astro';
import ServiceSearch from '../components/ServiceSearch.astro';
import {studioServices} from '../data/studio-services.js';
const base=import.meta.env.BASE_URL;
const headline='YOUR STORY.';
---
<SiteLayout title="Strategic Communications & Creative Services" description="The Odd Phoenix brings strategy, writing, branding, design, digital content, and e-commerce together for businesses and organizations.">
<section class="hero texture" aria-labelledby="hero-title"><div class="hero-layout"><div class="hero-title-block"><h1 id="hero-title" aria-label="Your story. Your way."><span class="story-line" aria-hidden="true">{[...headline].map((letter,i)=><span style={'--letter:'+i}>{letter===' '?'\u00a0':letter}</span>)}</span><span class="way-line"><span>Your way.</span></span></h1><div class="brush-underline" aria-hidden="true"></div></div><div class="hero-aside"><p>Smart strategy, sharp communication, and creative work for people doing things a little differently.</p><a class="button" href={base+'services/'}>See what we do <span aria-hidden="true">↗</span></a></div></div><a class="down-indicator" href="#services" aria-label="Explore our services"><span aria-hidden="true">⌄</span></a></section>
<section id="services" class="home-services texture torn-top" aria-labelledby="services-title"><div class="service-intro"><p class="eyebrow rule">What we do</p><h2 id="services-title">Oddly<br/><em>versatile.</em></h2><p class="editorial">Writing, branding, communications, websites, and online stores for businesses and organizations.</p></div><div class="photo-card-grid">{studioServices.slice(0,6).map(s=><a class={'photo-card '+s.image} href={base+'services/#'+s.id}><img src={base+'images/'+s.image+'.webp'} alt="" width="480" height="640" loading="lazy"/><div class="card-content"><h3>{s.title}</h3><span class="circle-arrow" aria-hidden="true">→</span></div></a>)}</div><details class="home-service-search"><summary>Looking for something specific? Search for a service ↗</summary><ServiceSearch/></details></section>
<ProjectStartingPoints/>
<section class="editorial-split client-focused"><div class="philosophy texture"><img class="philosophy-photo" src={base+'images/editorial.webp'} alt="Vintage typewriter with a blank sheet of paper" width="480" height="640" loading="lazy"/><div class="philosophy-copy"><h2>Less fluff.<br/><em>More substance.</em></h2><p class="editorial">We bring strategy, storytelling, and design together to make communication clearer, stronger, and more effective.</p><div class="brush-underline" aria-hidden="true"></div></div></div><aside class="lab-note texture"><p class="eyebrow">From The Lab</p><h2>Original ventures.</h2><p>Oddities, our dark tourism platform, is in production.</p><a href={base+'lab/'}>Visit The Lab <span aria-hidden="true">↗</span></a></aside></section>
<ProjectProcess/>
<ContactStrip/>

</SiteLayout>
