---
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import {services} from '../data/services.js';
const base=import.meta.env.BASE_URL;

import logo from '../../assets/logos/Logos_OddPhoenix_Primary_LightBG_Alt.png';
---
<SiteLayout title="Creative Services for Small Businesses" description="Writing and editing, graphic design, public relations, photography, and website services for small businesses and organizations. Creative work. Clear communication.">
<section class="hero wrap" aria-labelledby="hero-title"><div class="hero-top"><p class="eyebrow">AN INDEPENDENT CREATIVE STUDIO</p><p class="edition">WORDS. IMAGES. IDEAS.</p></div><div class="hero-grid"><div><h1 id="hero-title">CREATIVE WORK.<br/><em>CLEAR</em><br/>COMMUNICATION.</h1><p class="intro">Writing, design, public relations, and digital creative services for small businesses, entrepreneurs, and organizations.</p><div class="actions"><Button href={`${base}contact/`}>Discuss your project</Button><a class="text-link" href={`${base}services/`}>Explore services <span aria-hidden="true">↓</span></a></div></div><div class="brand-panel"><img src={logo.src} width="1650" height="1650" alt="The Odd Phoenix — official gold phoenix and wordmark" fetchpriority="high"/><p>ODD PHOENIX CREATIVE COMPANY</p></div></div><div class="hero-bottom"><span>WRITING · DESIGN · VISUAL STORYTELLING</span><a href="#services">A little different. By design. <span aria-hidden="true">↓</span></a></div></section>
<section id="services" class="services section"><div class="wrap"><div class="section-head"><p class="eyebrow">01 / WHAT WE DO</p><h2>MANY DISCIPLINES.<br/><em>ONE CLEAR PURPOSE.</em></h2><p>From original concepts to creative improvements, we help businesses communicate clearly and present themselves professionally.</p></div><div class="service-grid">{services.map((service,i)=><ServiceCard {...service} number={`0${i+1}`}/>)}</div></div></section>
<section id="portfolio" class="wrap section"><div class="split-heading"><div><p class="eyebrow">02 / SELECTED WORK</p><h2>THE WORK<br/><em>BEHIND THE WORDS.</em></h2></div><p>Writing, design, and visual storytelling.<br/>Selected projects will be added here.</p></div><div class="portfolio-placeholders" aria-label="Portfolio placeholders"><div><span>01 / WORDS & IDEAS</span><p>Writing & communications</p><small>PROJECTS COMING SOON</small></div><div><span>02 / FORM & PERSPECTIVE</span><p>Design & visual storytelling</p><small>PROJECTS COMING SOON</small></div></div></section>
<section id="about" class="about section"><div class="wrap about-grid"><div><p class="eyebrow">03 / THE STUDIO</p><h2>A DIFFERENT<br/>PERSPECTIVE.<br/><em>A THOUGHTFUL<br/>APPROACH.</em></h2></div><div><p class="large-copy">Good creative work starts with understanding what you want to say—and who needs to hear it.</p><p>Odd Phoenix Creative Company brings together journalism, professional communication, design, and visual storytelling to help small businesses, entrepreneurs, nonprofits, and community organizations.</p><p>Our approach is grounded in clear communication, accessibility, and practical creative solutions. Every project begins with a conversation.</p><a class="text-link" href={`${base}about/`}>Meet the studio <span aria-hidden="true">↗</span></a></div></div></section>
<section id="contact" class="wrap section contact"><p class="eyebrow">04 / START A CONVERSATION</p><h2>YOUR NEXT CHAPTER.<br/><em>LET’S CREATE IT.</em></h2><p>Tell us what you have in mind. We’ll talk through your goals<br class="desktop"/> and shape a customized quote around your project.</p><Button href={`${base}contact/`}>Discuss your project</Button><div class="process"><p><span>01</span> INQUIRE</p><p><span>02</span> CONSULT</p><p><span>03</span> QUOTE</p><p><span>04</span> CREATE</p></div></section>
</SiteLayout>
